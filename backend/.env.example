# SQLite is the zero-configuration default. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://skilltrace:skilltrace@localhost:5432/skilltrace
DATABASE_URL=sqlite:///./skilltrace.db
JWT_SECRET=replace-this-with-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://localhost:4173","http://127.0.0.1:4173"]
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880
AUTO_CREATE_TABLES=true
AUTO_SEED_DEMO=true
PROVINCE=Maharashtra
